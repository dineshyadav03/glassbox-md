# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
.env

# Data -- everything in data/ is either fetched by a script or generated
# locally; none of it belongs in version control, real or synthetic.
data/imaging/*
data/tabular/*
data/literature/*
data/synthetic_patients/*
data/cases/*
!data/imaging/.gitkeep
!data/tabular/.gitkeep
!data/literature/.gitkeep
!data/synthetic_patients/.gitkeep
!data/cases/.gitkeep
!data/README.md

# Chroma persistence
*.sqlite3
chroma/

# Chainlit runtime -- .files/ is where uploaded documents actually land on
# disk while the app runs. This must never be committed: it's the exact
# kind of real-or-synthetic patient document data/README.md already says
# doesn't belong in version control, just written by Chainlit instead of
# by hand. translations/ is auto-regenerated framework boilerplate
# (~400KB of locale JSON), not project content.
.files/
.chainlit/translations/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Test / tooling
.pytest_cache/
.ruff_cache/
*.egg-info
