# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real API keys.

# Phase 5 -- Diagnostic Prediction Agent. Routed through OpenRouter, not
# called directly against OpenAI or Gemini -- see the module docstring in
# agents/diagnostic_prediction.py for the full account of why (Gemini hit
# an unresolvable account-permission block; OpenAI has no meaningful free
# tier; a local Ollama model can't be reached by a deployed app).
OPENROUTER_API_KEY=
# openrouter/free auto-selects a free model that supports both image
# input and structured JSON output -- deliberately not a specific model
# name, since free-model availability on OpenRouter rotates over time.
OPENROUTER_MODEL=openrouter/free

# Phase 4 -- Medical Knowledge RAG Agent
CHROMA_PERSIST_DIR=./data/literature/chroma
PUBMED_ENTREZ_EMAIL=

# If this project is ever extended beyond synthetic data: OpenRouter's
# free router has no BAA and forwards to whichever underlying provider
# it selects. Real (non-synthetic) data would need a direct, BAA-covered
# provider (e.g. Azure OpenAI Service) instead, chosen deliberately
# rather than routed automatically.
