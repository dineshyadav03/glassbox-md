# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real API keys.

# Phase 5 -- Diagnostic Prediction Agent. Only one of these is required
# depending on which model you commit to (the brief recommends picking one,
# not keeping both as an open option).
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Phase 4 -- Medical Knowledge RAG Agent
CHROMA_PERSIST_DIR=./data/literature/chroma
PUBMED_ENTREZ_EMAIL=

# If this project is ever extended beyond synthetic data: the public
# Gemini API above has no BAA. Vertex AI does -- switch to it and set these
# instead before any real (non-synthetic) data flows through Phase 5.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=
